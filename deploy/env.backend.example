# /etc/cfo-ai/api.env
#
# Production runtime env for the FastAPI backend. Loaded by
# cfo-ai-api.service (systemd) via EnvironmentFile=.
#
# Permissions: mode 600, owned by `cfoai:cfoai`. Never world-readable.
#   sudo chown cfoai:cfoai /etc/cfo-ai/api.env
#   sudo chmod 600         /etc/cfo-ai/api.env
#
# Replace every <REPLACE_*> placeholder before bringing the service up.

# ── Where the backend serves CORS-allowed origins from ──────────────
# Comma-separated. Read by src/engine/__main__.py:206 → __init_app.
# Production frontend = cfo-ai.finance + www.cfo-ai.finance.
CORS_ORIGINS=https://cfo-ai.finance,https://www.cfo-ai.finance

# ── Supabase (same project the local .env uses) ─────────────────────
# These come from your Supabase project's Settings → API page.
# `cjclenykwlngqvapmisb` is the project ref already in use locally.
VITE_SUPABASE_URL=https://cjclenykwlngqvapmisb.supabase.co
VITE_SUPABASE_ANON_KEY=<REPLACE_WITH_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY>

# ── Anthropic (Ask CFO AI streaming endpoint) ───────────────────────
ANTHROPIC_API_KEY=<REPLACE_WITH_ANTHROPIC_API_KEY>

# ── Stripe (checkout + portal + webhook) ────────────────────────────
# `STRIPE_PRICE_*` entries are intentionally empty for now — your spec
# choice said price_ids aren't ready yet. Checkout will return 501 for
# trial/intro/starter/pro until you publish prices in Stripe dashboard
# and fill these in. Display surface + free trial signup do NOT need
# these to work.
STRIPE_SECRET_KEY=<REPLACE_WITH_STRIPE_LIVE_OR_TEST_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<REPLACE_AFTER_REGISTERING_WEBHOOK>

# Optional once prices are published:
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_INTRO_ONE_TIME=price_...

# ── Pricing config overrides (optional) ─────────────────────────────
# All have sensible defaults in src/engine/api/_pricing_config.py.
# Uncomment to override per-environment without a code change.
# PRICING_TRIAL_WINDOW_DAYS=7
# PRICING_TRIAL_INCLUDED_DOCS=1
# PRICING_INTRO_PRICE_EUR=0.99
# PRICING_INTRO_WINDOW_DAYS=7
# PRICING_STARTER_MONTHLY_EUR=14.99
# PRICING_STARTER_INCLUDED_DOCS=5
# PRICING_STARTER_EXTRA_DOC_EUR=3.00
# PRICING_PRO_MONTHLY_EUR=39.99
# PRICING_PRO_INCLUDED_DOCS=15
# PRICING_PRO_EXTRA_DOC_EUR=2.50

# ── Usage enforcement kill switch ───────────────────────────────────
# Leave on in prod (default). Set to false ONLY for an emergency
# disable; quota + chat caps stop applying.
# USAGE_LIMITS_ENABLED=true

# ── Mock billing (DEV ONLY) ─────────────────────────────────────────
# DO NOT set this in production. Allows extra-doc charges to succeed
# without hitting Stripe. Spec §17 — production must NOT enable this.
# ENABLE_MOCK_BILLING=false
