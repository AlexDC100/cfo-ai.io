# /opt/cfo-ai/.env
#
# Production env for the CFO AI backend container. Replace every
# <REPLACE_*> placeholder before `docker compose up`. File mode 600.
#
#   sudo chmod 600 /opt/cfo-ai/.env

# ── Supabase (same project the scandia stack uses today) ────────────
VITE_SUPABASE_URL=https://cjclenykwlngqvapmisb.supabase.co
VITE_SUPABASE_ANON_KEY=<REPLACE_WITH_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY>

# ── Anthropic (Ask CFO AI streaming endpoint) ───────────────────────
ANTHROPIC_API_KEY=<REPLACE_WITH_ANTHROPIC_API_KEY>

# ── Stripe (checkout + portal + webhook) ────────────────────────────
# Price IDs intentionally blank — your choice in the deploy plan said
# they're not ready yet. Checkout will return 501 for trial/intro/
# starter/pro until you publish prices in Stripe and add them below.
# Display surface + free-trial signup work without these.
STRIPE_SECRET_KEY=<REPLACE_WITH_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_INTRO_ONE_TIME=price_...

# ── Pricing config overrides (optional — defaults are in code) ──────
# PRICING_TRIAL_WINDOW_DAYS=7
# PRICING_STARTER_MONTHLY_EUR=14.99
# PRICING_PRO_MONTHLY_EUR=39.99

# ── Usage enforcement kill switch (leave on in prod) ────────────────
# USAGE_LIMITS_ENABLED=true

# ── Mock billing (DEV ONLY — DO NOT set in production) ──────────────
# ENABLE_MOCK_BILLING=false
