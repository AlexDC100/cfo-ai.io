# scandi-desk-main/.env.production
#
# Build-time env for the Vite frontend. Used ONLY during `npm run build`
# — Vite inlines these values into the bundled JS. Setting them at
# runtime on the server has no effect.
#
# Place this file at scandi-desk-main/.env.production on the VPS BEFORE
# running `npm run build`. Or pass them inline:
#   VITE_API_URL=https://api.cfo-ai.finance npm run build

# ── API base — MUST be the deployed backend hostname ────────────────
# Local default is http://127.0.0.1:8000 which won't work for end users
# (resolves to their own machine in production builds).
VITE_API_URL=https://api.cfo-ai.finance

# ── Supabase ─────────────────────────────────────────────────────────
# Same project ref the backend uses.
VITE_SUPABASE_URL=https://cjclenykwlngqvapmisb.supabase.co
VITE_SUPABASE_ANON_KEY=<REPLACE_WITH_SUPABASE_ANON_KEY>

# ── Optional: building-in-public social links ───────────────────────
# Surface on the landing page Final-CTA section. Leave blank to hide.
# VITE_SOCIAL_LINKEDIN=https://linkedin.com/in/...
# VITE_SOCIAL_X=https://x.com/...
# VITE_SOCIAL_YOUTUBE=https://youtube.com/...
# VITE_SOCIAL_INSTAGRAM=
# VITE_SOCIAL_TIKTOK=

# ── Optional: 60-second demo video on the landing page ─────────────
# Renders an "Or watch the 60-second demo" link below the hero. Leave
# blank to hide.
# VITE_DEMO_VIDEO_URL=https://...
