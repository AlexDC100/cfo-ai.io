#!/bin/sh
# Refuse to commit a planted defect.
#
# Gates in this project are certified by planting the defect they catch,
# observing RED, and reverting. On 2026-08-30 a `git add -A` ran while a
# lane's plant was live, and commit 36d34ef shipped
# `if (false && answerLocally(...))` to main: every Tier-0 question
# straight to the paid model seam, inside the commit certifying that the
# gate catches exactly that. The lane reverted the WORKING TREE
# afterwards, so by the time anyone looked the tree was clean and only
# the commit carried it.
#
# The battery catches this too, but the battery runs after the fact. This
# runs at the moment the mistake would happen, and it reads the STAGED
# blobs rather than the tree, because the tree is what lied last time.
#
# Versioned deliberately: .git/hooks/ is not tracked, so a hook living
# there would not survive a fresh clone. Enabled by
#   git config core.hooksPath .githooks
# which scripts/dev_setup.sh sets, and which this repo's checkout already
# has.
#
# Escape hatch, for the rare deliberate case: SKIP_PLANT_CHECK=1 git commit
if [ -n "$SKIP_PLANT_CHECK" ]; then
  echo "pre-commit: plant check SKIPPED by SKIP_PLANT_CHECK" >&2
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found; plant check could not run." >&2
  echo "This is a FAILURE, not a skip — an unrunnable guard is not a guard." >&2
  exit 1
fi

node scripts/check_no_plants.mjs --staged || {
  echo "" >&2
  echo "pre-commit REFUSED: a planted defect is staged." >&2
  echo "Revert the plant, then commit. Record the evidence in the" >&2
  echo "feature's GATES.md, where this scan deliberately does not look." >&2
  exit 1
}
