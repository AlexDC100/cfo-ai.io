# CFO AI — environment example.
# Copy to .env (or .env.local) and fill in real values. Vite exposes any
# variable prefixed with VITE_ to the browser bundle, so don't put secrets
# here — only public URLs and IDs.

# ── Backend + Supabase ──────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Social profiles (footer + closing CTA) ──────────────────────────
# Leave any of these EMPTY and the corresponding icon won't render — we
# never ship dead social links. Fill in as each account goes live.
#
# Order of importance: LinkedIn → X → YouTube → Instagram → TikTok.
# LinkedIn is the primary B2B channel; YouTube is the credibility channel
# (product demos); X is the build-in-public channel; Instagram + TikTok
# are top-of-funnel reach.
#
# Recommended handles (pick one and use it consistently across platforms):
#   /company/cfo-ai (LinkedIn) or your taken alternative
#   @cfo_ai / @getcfoai / @cfoai_official  (the rest — pick what's available)

VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=

# Closing-CTA video link — the 60-second product demo. Same URL as the
# YouTube channel's pinned video, or a Loom while the YouTube version is
# being recorded. Hidden if unset.
VITE_DEMO_VIDEO_URL=
