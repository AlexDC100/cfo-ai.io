# Frontend image — Vite build → static files behind tiny nginx.
# Caddy reverse-proxies to nginx for / and to the backend for /api etc.

# ─── Build stage ───
FROM node:20-alpine AS build
WORKDIR /app

# VITE_API_URL is empty → frontend calls relative paths (`/api/skus`,
# `/health`) which Caddy routes to the backend. Same-origin = no CORS.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
# Public VITE_ config — passed as build args from docker-compose (there is no
# .env.production in the build context; Vite inlines these at build time).
ARG VITE_SUPABASE_URL=""
ARG VITE_SUPABASE_ANON_KEY=""
ARG VITE_SITE_DOMAIN=""
ARG VITE_SITE_URL=""
ARG VITE_PUBLIC_TEST_MODE=""
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_SITE_DOMAIN=$VITE_SITE_DOMAIN \
    VITE_SITE_URL=$VITE_SITE_URL \
    VITE_PUBLIC_TEST_MODE=$VITE_PUBLIC_TEST_MODE

COPY package.json package-lock.json ./
# `npm install` (not `npm ci`) — the lockfile in this repo lags some deps
# in package.json. Install resolves the gap by updating the lockfile in place
# inside the image. For stricter reproducibility, regenerate the lockfile
# locally with `npm install` and switch this back to `npm ci`.
RUN npm install --no-audit --no-fund --legacy-peer-deps

COPY index.html vite.config.ts tailwind.config.ts postcss.config.js ./
COPY tsconfig.json tsconfig.app.json tsconfig.node.json components.json ./
COPY frontend/ ./frontend/
COPY public/ ./public/
RUN npm run build

# ─── Runtime stage ───
FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
