.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
.mypy_cache/
*.egg-info/
output/*.json
.DS_Store

# Local dev compose override — never deployed
docker-compose.override.yml

# Production secrets — never commit
.env
.env.local
.env.production
# Hermetic gate stacks (e2e/launch-route-cut.spec.ts). Both pin Supabase at
# the unresolvable test host so neither can reach production — but neither
# belongs in the repo either.
.env.launchgate*
# The LOCAL test Supabase's environment (CLAUDE.md §27): the engine's and the
# test-mode Vite's Supabase URL + the local stack's keys. The keys are the
# CLI's public demo defaults, and still never tracked — a tracked .env.test
# is one paste away from carrying a hosted project's key.
.env.test
.env.test.local

# Frontend build artifacts
node_modules/
dist/
.vite/

# Local data dumps (top-level only — must not match frontend/data/, which is
# bundled source, e.g. frontend/data/dailyRun.ts)
/data/

# Runtime artifacts (do not commit)
logs/
supabase/.temp/

# Per-build supply-chain artifacts (SBOM + SLSA provenance) — derived
# output regenerated on every build by scripts/generate_sbom.py and
# scripts/generate_provenance.py; committing one would drift from the
# lock/commit it describes.
deploy/artifacts/

.claude/

# LEARN-MOBILE / repo-init (2026-06-16): exclude customer trial-balance
# uploads + test artifacts that don't belong in source control.
files/
out/
test-results/
test-results*/
test-results/
test-results*/
.DS_Store
e2e/artifacts/
scandi-desk-main/
