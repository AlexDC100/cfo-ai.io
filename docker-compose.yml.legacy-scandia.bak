# Three-container stack for the Scandia SKU Decision Engine.
#
#   backend   — FastAPI engine (Python). Port 8000, internal-only.
#   frontend  — Vite build served by nginx. Port 80, internal-only.
#   caddy     — Reverse proxy + auto-TLS (Let's Encrypt). Public on 80/443.
#
# Run:
#   cp .env.example .env  (then fill in real values)
#   docker compose up -d --build
#   docker compose logs -f

services:
  backend:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: scandia-backend
    restart: unless-stopped
    env_file: .env
    environment:
      # CORS: not strictly needed since Caddy serves frontend + backend same-origin,
      # but listed here so the API is also reachable from a separate hostname if you
      # ever decide to split them. Add a comma-separated list if so.
      CORS_ORIGINS: "https://scandiafood-sku.online,https://www.scandiafood-sku.online"
    volumes:
      - backend_data:/app/data
    expose:
      - "8000"
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health').read()"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

  frontend:
    build:
      context: ./scandi-desk-main
      dockerfile: Dockerfile
      args:
        # Empty string → frontend uses relative URLs (/api, /health) so Caddy
        # routes to the backend on the same origin. Don't change this without
        # also updating the Caddyfile.
        VITE_API_URL: ""
    container_name: scandia-frontend
    restart: unless-stopped
    expose:
      - "80"

  caddy:
    image: caddy:2-alpine
    container_name: scandia-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - backend
      - frontend

volumes:
  backend_data:
  caddy_data:
  caddy_config:
